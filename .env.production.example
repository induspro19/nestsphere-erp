# Production Environment Configuration Example
NODE_ENV=production
PORT=3000

# Database
DATABASE_URL="postgresql://nestsphere_prod_user:PROD_SECURE_PASSWORD@postgres.internal:5432/nestsphere_erp_prod?schema=public&sslmode=require"

# Redis
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=REDIS_SECURE_PASSWORD

# Security
JWT_SECRET=PROD_HIGH_ENTROPY_JWT_SECRET_32_BYTES_MINIMUM
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=PROD_HIGH_ENTROPY_REFRESH_SECRET_32_BYTES_MINIMUM
JWT_REFRESH_EXPIRATION=7d

# CORS & Domains
ALLOWED_ORIGINS=https://app.nestsphere.com,https://admin.nestsphere.com

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
