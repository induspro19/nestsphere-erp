// ======================================================
// 16. ENTERPRISE AMENITY BOOKING & FACILITY RESERVATION
// ======================================================

model Amenity {
  id             String   @id @default(uuid()) @db.Uuid
  societyId      String   @map("society_id") @db.Uuid
  categoryCode   String   @map("category_code") @db.VarChar(50) // e.g. CLUB_HOUSE, GYM, SWIMMING_POOL
  name           String   @db.VarChar(150)
  description    String?  @db.Text
  location       String?  @db.VarChar(255)
  buildingId     String?  @map("building_id") @db.Uuid
  capacity       Int      @default(10)

  // Booking rules
  bookingTypes         Json?   @map("booking_types") // ["HOURLY","DAILY"]
  minBookingHours      Int     @default(1) @map("min_booking_hours")
  maxBookingHours      Int     @default(4) @map("max_booking_hours")
  maxAdvanceBookDays   Int     @default(30) @map("max_advance_book_days")
  maxBookingsPerMember Int     @default(2) @map("max_bookings_per_member")
  requiresApproval     Boolean @default(false) @map("requires_approval")

  // Charges
  hourlyRate       Decimal @default(0) @map("hourly_rate") @db.Decimal(10, 2)
  dailyRate        Decimal @default(0) @map("daily_rate") @db.Decimal(10, 2)
  securityDeposit  Decimal @default(0) @map("security_deposit") @db.Decimal(10, 2)
  cancellationFee  Decimal @default(0) @map("cancellation_fee") @db.Decimal(10, 2)

  // Operational
  openTime         String  @default("06:00") @map("open_time") @db.VarChar(5)  // "HH:MM"
  closeTime        String  @default("22:00") @map("close_time") @db.VarChar(5)
  operatingDays    Json?   @map("operating_days") // ["MON","TUE",...]
  maintenanceDays  Json?   @map("maintenance_days") // blocked dates
  amenityRules     String? @map("amenity_rules") @db.Text

  photoUrls  Json?
  qrToken    String? @map("qr_token") @db.VarChar(255)
  isActive   Boolean @default(true) @map("is_active")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")

  society   Society          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  bookings  AmenityBooking[]
  waitlist  AmenityWaitlist[]

  @@index([societyId, isDeleted])
  @@index([societyId, categoryCode])
  @@map("amenities")
}

model AmenityBooking {
  id             String               @id @default(uuid()) @db.Uuid
  societyId      String               @map("society_id") @db.Uuid
  amenityId      String               @map("amenity_id") @db.Uuid
  personId       String               @map("person_id") @db.Uuid
  bookingNumber  String               @unique @map("booking_number") @db.VarChar(50) // AMB-00001
  bookingType    AmenityBookingType   @default(HOURLY) @map("booking_type")
  status         AmenityBookingStatus @default(PENDING_APPROVAL) @map("status")

  bookingDate    DateTime @map("booking_date") @db.Date
  startTime      String   @map("start_time") @db.VarChar(5)  // "HH:MM"
  endTime        String   @map("end_time") @db.VarChar(5)
  durationHours  Float    @default(1) @map("duration_hours")
  guestCount     Int      @default(1) @map("guest_count")
  purposeNotes   String?  @map("purpose_notes") @db.VarChar(255)

  // Recurring booking support
  isRecurring         Boolean  @default(false) @map("is_recurring")
  recurringDays       Json?    @map("recurring_days")
  recurringEndDate    DateTime? @map("recurring_end_date")

  // Financials
  bookingCharge    Decimal  @default(0) @map("booking_charge") @db.Decimal(10, 2)
  securityDeposit  Decimal  @default(0) @map("security_deposit") @db.Decimal(10, 2)
  damageCharges    Decimal  @default(0) @map("damage_charges") @db.Decimal(10, 2)
  cancellationFee  Decimal  @default(0) @map("cancellation_fee") @db.Decimal(10, 2)
  totalAmount      Decimal  @default(0) @map("total_amount") @db.Decimal(10, 2)
  paidAmount       Decimal  @default(0) @map("paid_amount") @db.Decimal(10, 2)
  refundAmount     Decimal  @default(0) @map("refund_amount") @db.Decimal(10, 2)
  paymentMethod    PaymentMethod @default(RAZORPAY) @map("payment_method")
  gatewayRef       String?  @map("gateway_ref") @db.VarChar(100)

  // Attendance
  qrToken       String?   @map("qr_token") @db.VarChar(255)
  checkedInAt   DateTime? @map("checked_in_at")
  checkedOutAt  DateTime? @map("checked_out_at")
  checkedInBy   String?   @db.Uuid @map("checked_in_by")

  // Workflow / cancellation
  approvedBy       String?  @db.Uuid @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  rejectionReason  String?  @map("rejection_reason") @db.VarChar(255)
  cancelledBy      String?  @db.Uuid @map("cancelled_by")
  cancelledAt      DateTime? @map("cancelled_at")
  cancellationNote String?  @map("cancellation_note") @db.VarChar(255)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([societyId, bookingDate, status])
  @@index([amenityId, bookingDate])
  @@index([personId])
  @@index([bookingNumber])
  @@map("amenity_bookings")
}

model AmenityWaitlist {
  id          String   @id @default(uuid()) @db.Uuid
  amenityId   String   @map("amenity_id") @db.Uuid
  personId    String   @map("person_id") @db.Uuid
  bookingDate DateTime @map("booking_date") @db.Date
  startTime   String   @map("start_time") @db.VarChar(5)
  endTime     String   @map("end_time") @db.VarChar(5)
  position    Int      @default(1)
  isNotified  Boolean  @default(false) @map("is_notified")
  expiresAt   DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@index([amenityId, bookingDate])
  @@map("amenity_waitlist")
}

// ======================================================
// 17. ENTERPRISE PARKING & VEHICLE MANAGEMENT
// ======================================================

model ParkingZone {
  id          String      @id @default(uuid()) @db.Uuid
  societyId   String      @map("society_id") @db.Uuid
  buildingId  String?     @map("building_id") @db.Uuid
  code        String      @db.VarChar(50)
  name        String      @db.VarChar(150)
  parkingType ParkingType @map("parking_type")
  floor       String?     @db.VarChar(50)
  totalSlots  Int         @default(0) @map("total_slots")
  description String?     @db.Text
  isActive    Boolean     @default(true) @map("is_active")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")

  society Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  slots   ParkingSlot[]

  @@unique([societyId, code])
  @@index([societyId, isDeleted])
  @@map("parking_zones")
}

model ParkingSlot {
  id         String            @id @default(uuid()) @db.Uuid
  societyId  String            @map("society_id") @db.Uuid
  zoneId     String            @map("zone_id") @db.Uuid
  slotNumber String            @map("slot_number") @db.VarChar(50)
  slotSize   ParkingSlotSize   @default(CAR) @map("slot_size")
  status     ParkingSlotStatus @default(AVAILABLE)
  floor      String?           @db.VarChar(50)
  block      String?           @db.VarChar(50)
  location   String?           @db.VarChar(255)

  isEvEnabled   Boolean @default(false) @map("is_ev_enabled")
  isRfidEnabled Boolean @default(false) @map("is_rfid_enabled")
  isQrEnabled   Boolean @default(true) @map("is_qr_enabled")
  isBoomBarrier Boolean @default(false) @map("is_boom_barrier")
  isDisabled    Boolean @default(false) @map("is_disabled")

  qrToken     String? @map("qr_token") @db.VarChar(255)
  monthlyRate Decimal @default(0) @map("monthly_rate") @db.Decimal(10, 2)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")

  society     Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  zone        ParkingZone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  allocations ParkingAllocation[]

  @@unique([zoneId, slotNumber])
  @@index([societyId, status])
  @@index([societyId, isDeleted])
  @@map("parking_slots")
}

model ParkingAllocation {
  id               String                  @id @default(uuid()) @db.Uuid
  societyId        String                  @map("society_id") @db.Uuid
  slotId           String                  @map("slot_id") @db.Uuid
  vehicleId        String                  @map("vehicle_id") @db.Uuid
  personId         String                  @map("person_id") @db.Uuid
  unitId           String?                 @map("unit_id") @db.Uuid
  allocationNumber String                  @unique @map("allocation_number") @db.VarChar(50) // PA-00001
  allocationType   String                  @default("PERMANENT") @map("allocation_type") @db.VarChar(50)
  status           ParkingAllocationStatus @default(PENDING)

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  monthlyCharge Decimal @default(0) @map("monthly_charge") @db.Decimal(10, 2)
  depositPaid   Decimal @default(0) @map("deposit_paid") @db.Decimal(10, 2)

  approvedBy String?   @db.Uuid @map("approved_by")
  approvedAt DateTime? @map("approved_at")
  notes      String?   @db.VarChar(255)

  // Transfer / Swap tracking
  transferredToPersonId String? @db.Uuid @map("transferred_to_person_id")
  transferredAt         DateTime? @map("transferred_at")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")

  society Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  slot    ParkingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  vehicle Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  person  Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  unit    Flat?       @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([societyId, status])
  @@index([slotId])
  @@index([vehicleId])
  @@index([allocationNumber])
  @@map("parking_allocations")
}

// ======================================================
// 18. ENTERPRISE VENDOR & AMC MANAGEMENT
// ======================================================

model Vendor {
  id         String       @id @default(uuid()) @db.Uuid
  societyId  String       @map("society_id") @db.Uuid
  vendorCode String       @map("vendor_code") @db.VarChar(50)   // VEN-00001
  name       String       @db.VarChar(255)
  typeCode   String       @map("type_code") @db.VarChar(80)     // ELECTRICAL, PLUMBING, etc.
  status     VendorStatus @default(ACTIVE)

  // GST / Legal
  gstNumber     String? @map("gst_number") @db.VarChar(20)
  panNumber     String? @map("pan_number") @db.VarChar(20)
  licenseNumber String? @map("license_number") @db.VarChar(100)

  // Contact
  primaryEmail   String? @map("primary_email") @db.VarChar(255)
  primaryPhone   String? @map("primary_phone") @db.VarChar(20)
  website        String? @db.VarChar(255)

  // Address
  addressLine1 String? @map("address_line_1") @db.VarChar(255)
  addressLine2 String? @map("address_line_2") @db.VarChar(255)
  city         String? @db.VarChar(100)
  state        String? @db.VarChar(100)
  country      String? @default("India") @db.VarChar(100)
  pincode      String? @db.VarChar(20)

  // Bank & Payment
  bankName      String? @map("bank_name") @db.VarChar(150)
  accountNumber String? @map("account_number") @db.VarChar(50)
  ifscCode      String? @map("ifsc_code") @db.VarChar(20)
  upiId         String? @map("upi_id") @db.VarChar(100)

  // Performance / Rating (0-5)
  rating        Decimal @default(0) @db.Decimal(3, 2)
  totalContracts Int    @default(0) @map("total_contracts")
  totalContractValue Decimal @default(0) @map("total_contract_value") @db.Decimal(14, 2)
  penaltyAmount  Decimal @default(0) @map("penalty_amount") @db.Decimal(12, 2)

  // Flags
  isEmergencyContact Boolean @default(false) @map("is_emergency_contact")
  isPreferred        Boolean @default(false) @map("is_preferred")
  isBlacklisted      Boolean @default(false) @map("is_blacklisted")

  qrToken   String? @map("qr_token") @db.VarChar(255)
  notes     String? @db.Text

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")

  society      Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  contacts     VendorContact[]
  amcContracts AmcContract[]
  serviceVisits ServiceVisit[]

  @@unique([societyId, vendorCode])
  @@index([societyId, isDeleted])
  @@index([societyId, typeCode])
  @@map("vendors")
}

model VendorContact {
  id        String  @id @default(uuid()) @db.Uuid
  vendorId  String  @map("vendor_id") @db.Uuid
  name      String  @db.VarChar(150)
  designation String? @db.VarChar(100)
  email     String? @db.VarChar(255)
  phone     String  @db.VarChar(20)
  isEmergency Boolean @default(false) @map("is_emergency")
  isPrimary  Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_contacts")
}

model AmcContract {
  id             String            @id @default(uuid()) @db.Uuid
  societyId      String            @map("society_id") @db.Uuid
  vendorId       String            @map("vendor_id") @db.Uuid
  amcNumber      String            @unique @map("amc_number") @db.VarChar(50)  // AMC-00001
  contractNumber String?           @map("contract_number") @db.VarChar(100)
  contractType   AmcContractType   @map("contract_type")
  status         AmcContractStatus @default(DRAFT)

  // Dates
  startDate     DateTime  @map("start_date")
  endDate       DateTime  @map("end_date")
  renewalReminderDays Int @default(30) @map("renewal_reminder_days")
  autoRenew     Boolean   @default(false) @map("auto_renew")

  // SLA
  slaResponseHours   Int @default(4)  @map("sla_response_hours")
  slaResolutionHours Int @default(24) @map("sla_resolution_hours")
  visitFrequency     String? @map("visit_frequency") @db.VarChar(50)  // MONTHLY, QUARTERLY, etc.

  // Financial
  contractValue   Decimal @default(0) @map("contract_value") @db.Decimal(14, 2)
  amcCostPerMonth Decimal @default(0) @map("amc_cost_per_month") @db.Decimal(12, 2)
  penaltyPerHour  Decimal @default(0) @map("penalty_per_hour") @db.Decimal(10, 2)

  // Insurance & Warranty
  insuranceNumber  String? @map("insurance_number") @db.VarChar(100)
  insuranceExpiry  DateTime? @map("insurance_expiry")
  warrantyDetails  String? @map("warranty_details") @db.Text

  // Escalation
  escalationMatrix Json? @map("escalation_matrix")

  description String? @db.Text
  terms       String? @db.Text

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")

  society       Society        @relation(fields: [societyId], references: [id], onDelete: Cascade)
  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  assetLinks    AmcAssetLink[]
  serviceVisits ServiceVisit[]

  @@index([societyId, status])
  @@index([vendorId])
  @@index([amcNumber])
  @@map("amc_contracts")
}

model AmcAssetLink {
  id          String   @id @default(uuid()) @db.Uuid
  amcId       String   @map("amc_id") @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  notes       String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  amc   AmcContract @relation(fields: [amcId], references: [id], onDelete: Cascade)
  asset Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([amcId, assetId])
  @@map("amc_asset_links")
}

model ServiceVisit {
  id            String             @id @default(uuid()) @db.Uuid
  societyId     String             @map("society_id") @db.Uuid
  vendorId      String             @map("vendor_id") @db.Uuid
  amcId         String?            @map("amc_id") @db.Uuid
  visitNumber   String             @unique @map("visit_number") @db.VarChar(50)  // SV-00001
  visitType     ServiceVisitType   @map("visit_type")
  status        ServiceVisitStatus @default(SCHEDULED)

  scheduledDate DateTime  @map("scheduled_date")
  actualDate    DateTime? @map("actual_date")
  completedAt   DateTime? @map("completed_at")

  technicianName  String? @map("technician_name") @db.VarChar(150)
  technicianPhone String? @map("technician_phone") @db.VarChar(20)

  checklist       Json?  // { item: string, completed: boolean }[]
  workDescription String? @map("work_description") @db.Text
  technicalNotes  String? @map("technical_notes") @db.Text
  attachments     Json?  // photo URLs

  // Feedback
  residentRating  Int?     @map("resident_rating")
  residentFeedback String? @map("resident_feedback") @db.VarChar(500)

  // Financials
  labourCost    Decimal @default(0) @map("labour_cost") @db.Decimal(10, 2)
  materialCost  Decimal @default(0) @map("material_cost") @db.Decimal(10, 2)
  totalCost     Decimal @default(0) @map("total_cost") @db.Decimal(12, 2)
  penaltyAmount Decimal @default(0) @map("penalty_amount") @db.Decimal(10, 2)

  // Response SLA tracking
  reportedAt    DateTime? @map("reported_at")
  respondedAt   DateTime? @map("responded_at")
  responseMinutes Int?    @map("response_minutes")

  hasDigitalSignature Boolean @default(false) @map("has_digital_signature")
  signatureUrl        String? @map("signature_url") @db.VarChar(500)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")

  society Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amc     AmcContract? @relation(fields: [amcId], references: [id], onDelete: SetNull)
  parent  Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId, status])
  @@index([vendorId])
  @@index([amcId])
  @@map("service_visits")
}

// ======================================================
// ENTERPRISE MEETING MANAGEMENT ENGINE
// ======================================================

enum MeetingType {
  AGM
  SGM
  COMMITTEE
  EMERGENCY
  VIRTUAL
  HYBRID
}

enum MeetingMode {
  PHYSICAL
  ONLINE
  HYBRID
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum AttendanceRole {
  CHAIRPERSON
  SECRETARY
  MEMBER
  GUEST
  SPEAKER
  ATTENDEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ResolutionStatus {
  APPROVED
  REJECTED
  DEFERRED
  VOTING_REQUIRED
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Meeting {
  id            String        @id @default(uuid()) @db.Uuid
  societyId     String        @map("society_id") @db.Uuid
  meetingNumber String        @unique @map("meeting_number") @db.VarChar(50) // MTG-00001
  title         String        @db.VarChar(255)
  meetingType   MeetingType   @map("meeting_type")
  meetingMode   MeetingMode   @default(PHYSICAL) @map("meeting_mode")
  meetingStatus MeetingStatus @default(DRAFT) @map("meeting_status")
  description   String?       @db.Text

  meetingDate   DateTime      @map("meeting_date")
  startTime     String        @map("start_time") @db.VarChar(10)
  endTime       String        @map("end_time") @db.VarChar(10)
  venue         String?       @db.VarChar(255)
  meetingUrl    String?       @map("meeting_url") @db.VarChar(500)
  meetingLink   String?       @map("meeting_link") @db.VarChar(500)
  meetingPlatform String?     @map("meeting_platform") @db.VarChar(100)
  meetingPassword String?     @map("meeting_password") @db.VarChar(100)

  // Recurrence
  isRecurring       Boolean        @default(false) @map("is_recurring")
  recurrenceType    RecurrenceType @default(NONE) @map("recurrence_type")
  recurrenceEndDate DateTime?      @map("recurrence_end_date")

  chairPersonId String?       @map("chair_person_id") @db.Uuid
  secretaryId   String?       @map("secretary_id") @db.Uuid

  requiresApproval   Boolean  @default(false) @map("requires_approval")
  workflowInstanceId String?  @map("workflow_instance_id") @db.Uuid

  // Quorum Tracking
  requiredQuorum    Int       @default(5) @map("required_quorum")
  achievedQuorum    Int       @default(0) @map("achieved_quorum")
  isQuorumAchieved  Boolean   @default(false) @map("is_quorum_achieved")

  // Minutes of Meeting (MoM)
  minutesPrepared     Boolean   @default(false) @map("minutes_prepared")
  minutesPreparedBy   String?   @map("minutes_prepared_by") @db.Uuid
  minutesApproved     Boolean   @default(false) @map("minutes_approved")
  minutesApprovedDate DateTime? @map("minutes_approved_date")
  minutesNotes        String?   @map("minutes_notes") @db.Text

  // Official Meeting Notice (Linked to Document Engine)
  noticePublished   Boolean   @default(false) @map("notice_published")
  noticePublishedAt DateTime? @map("notice_published_at")
  noticeDocumentId  String?   @map("notice_document_id") @db.Uuid

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")

  society      Society              @relation(fields: [societyId], references: [id], onDelete: Cascade)
  chairPerson  Person?              @relation("MeetingChairPerson", fields: [chairPersonId], references: [id], onDelete: SetNull)
  secretary    Person?              @relation("MeetingSecretaryPerson", fields: [secretaryId], references: [id], onDelete: SetNull)

  agendas      MeetingAgenda[]
  participants MeetingParticipant[]
  resolutions  MeetingResolution[]
  actionItems  MeetingActionItem[]

  @@index([societyId, meetingStatus])
  @@index([societyId, meetingType])
  @@index([meetingDate])
  @@map("meetings")
}

model MeetingAgenda {
  id                String   @id @default(uuid()) @db.Uuid
  meetingId         String   @map("meeting_id") @db.Uuid
  agendaNumber      String   @map("agenda_number") @db.VarChar(50)
  title             String   @db.VarChar(255)
  description       String?  @db.Text
  presenter         String?  @db.VarChar(150)
  estimatedDuration Int      @default(15) @map("estimated_duration")
  sequence          Int      @default(1)

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, sequence])
  @@map("meeting_agendas")
}

model MeetingParticipant {
  id               String           @id @default(uuid()) @db.Uuid
  meetingId        String           @map("meeting_id") @db.Uuid
  personId         String           @map("person_id") @db.Uuid
  role             AttendanceRole   @default(MEMBER)
  invitationStatus InvitationStatus @default(PENDING) @map("invitation_status")
  attendanceStatus AttendanceStatus @default(ABSENT) @map("attendance_status")
  checkInTime      DateTime?        @map("check_in_time")
  remarks          String?          @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([meetingId, personId])
  @@index([meetingId, attendanceStatus])
  @@map("meeting_participants")
}

model MeetingResolution {
  id                 String           @id @default(uuid()) @db.Uuid
  meetingId          String           @map("meeting_id") @db.Uuid
  resolutionNumber   String           @map("resolution_number") @db.VarChar(50)
  title              String           @db.VarChar(255)
  description        String           @db.Text
  status             ResolutionStatus @default(VOTING_REQUIRED)
  votingRequired     Boolean          @default(true) @map("voting_required")

  votesFor           Int              @default(0) @map("votes_for")
  votesAgainst       Int              @default(0) @map("votes_against")
  abstained          Int              @default(0) @map("abstained")
  passedByPercentage Decimal          @default(0) @map("passed_by_percentage") @db.Decimal(5, 2)
  votingClosedAt     DateTime?        @map("voting_closed_at")
  remarks            String?          @db.Text

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
  @@map("meeting_resolutions")
}

model MeetingActionItem {
  id                   String             @id @default(uuid()) @db.Uuid
  meetingId            String             @map("meeting_id") @db.Uuid
  task                 String             @db.VarChar(255)
  ownerId              String?            @map("owner_id") @db.Uuid
  ownerName            String?            @map("owner_name") @db.VarChar(150)
  dueDate              DateTime?          @map("due_date")
  priority             ActionItemPriority @default(MEDIUM)
  status               ActionItemStatus   @default(OPEN)
  completionPercentage Int                @default(0) @map("completion_percentage")
  remarks              String?            @db.Text

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  owner   Person? @relation("MeetingTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([meetingId, status])
  @@index([ownerId])
  @@map("meeting_action_items")
}

model MeetingTemplate {
  id                String      @id @default(uuid()) @db.Uuid
  societyId         String      @map("society_id") @db.Uuid
  name              String      @db.VarChar(255)
  meetingType       MeetingType @map("meeting_type")
  defaultAgenda     Json?       @map("default_agenda")
  estimatedDuration Int         @default(60) @map("estimated_duration")
  status            String      @default("ACTIVE") @db.VarChar(50)

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId, meetingType])
  @@map("meeting_templates")
}

// ======================================================
// NOTICE BOARD ENGINE (PHASE 22.1)
// ======================================================

enum NoticeCategory {
  GENERAL
  MAINTENANCE
  EMERGENCY
  EVENT
  SECURITY
  FINANCE
  AGM
  SGM
  WATER
  ELECTRICITY
  PARKING
  HOUSEKEEPING
  FESTIVAL
  LEGAL
  OTHER
}

enum NoticePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  EMERGENCY
}

enum NoticeStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  EXPIRED
  CANCELLED
}

enum NoticeTargetType {
  ENTIRE_SOCIETY
  BUILDING
  WING
  FLOOR
  UNIT
  ROLE
  INDIVIDUAL
}

enum AcknowledgementStatus {
  PENDING
  READ
  ACKNOWLEDGED
}

model Notice {
  id                      String         @id @default(uuid()) @db.Uuid
  societyId               String         @map("society_id") @db.Uuid
  noticeNumber            String         @unique @map("notice_number") @db.VarChar(50) // NTC-00001
  title                   String         @db.VarChar(255)
  description             String         @db.Text
  category                NoticeCategory
  priority                NoticePriority @default(MEDIUM)
  status                  NoticeStatus   @default(DRAFT)
  publishDate             DateTime?      @map("publish_date")
  expiryDate              DateTime?      @map("expiry_date")
  requiresApproval        Boolean        @default(false) @map("requires_approval")
  requiresAcknowledgement Boolean        @default(false) @map("requires_acknowledgement")

  createdById String? @map("created_by_id") @db.Uuid
  approvedById String? @map("approved_by_id") @db.Uuid

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  society    Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  createdBy  Person?           @relation("NoticeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy Person?           @relation("NoticeApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  recipients NoticeRecipient[]

  @@index([societyId])
  @@index([noticeNumber])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([publishDate])
  @@map("notices")
}

model NoticeRecipient {
  id                    String                @id @default(uuid()) @db.Uuid
  noticeId              String                @map("notice_id") @db.Uuid
  personId              String                @map("person_id") @db.Uuid
  targetType            NoticeTargetType      @default(ENTIRE_SOCIETY) @map("target_type")
  acknowledgementStatus AcknowledgementStatus @default(PENDING) @map("acknowledgement_status")
  readAt                DateTime?             @map("read_at")
  acknowledgedAt        DateTime?             @map("acknowledged_at")
  createdAt             DateTime              @default(now()) @map("created_at")

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([noticeId])
  @@index([personId])
  @@index([acknowledgementStatus])
  @@map("notice_recipients")
}

model NoticeTemplate {
  id           String         @id @default(uuid()) @db.Uuid
  societyId    String         @map("society_id") @db.Uuid
  templateName String         @map("template_name") @db.VarChar(255)
  category     NoticeCategory
  title        String         @db.VarChar(255)
  description  String         @db.Text
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId])
  @@map("notice_templates")
}


// ======================================================
// PHASE 38: ENTERPRISE ELECTION & COMMITTEE MANAGEMENT
// ======================================================

model Election {
  id                  String    @id @default(uuid()) @db.Uuid
  societyId           String    @map("society_id") @db.Uuid
  title               String    @db.VarChar(255)
  description         String?   @db.Text
  electionType        String    @map("election_type") @db.VarChar(50)
  status              String    @default("DRAFT") @db.VarChar(30)
  returningOfficerId  String?   @map("returning_officer_id") @db.Uuid
  quorumPercentage    Int       @default(50) @map("quorum_percentage")
  isSecretBallot      Boolean   @default(true) @map("is_secret_ballot")
  allowProxy          Boolean   @default(false) @map("allow_proxy")
  votingRule          String    @default("ONE_VOTE_PER_FLAT") @map("voting_rule") @db.VarChar(50)
  nominationStartDate DateTime? @map("nomination_start_date")
  nominationEndDate   DateTime? @map("nomination_end_date")
  scrutinyEndDate     DateTime? @map("scrutiny_end_date")
  withdrawalEndDate   DateTime? @map("withdrawal_end_date")
  campaignStartDate   DateTime? @map("campaign_start_date")
  campaignEndDate     DateTime? @map("campaign_end_date")
  votingStartDate     DateTime? @map("voting_start_date")
  votingEndDate       DateTime? @map("voting_end_date")
  resultDate          DateTime? @map("result_date")
  appealEndDate       DateTime? @map("appeal_end_date")
  certifiedAt         DateTime? @map("certified_at")
  isDeleted           Boolean   @default(false) @map("is_deleted")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by") @db.Uuid

  society   Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  positions ElectionPosition[]
  auditLogs ElectionAuditLog[]

  @@index([societyId, status])
  @@map("elections")
}

model ElectionPosition {
  id            String  @id @default(uuid()) @db.Uuid
  electionId    String  @map("election_id") @db.Uuid
  positionTitle String  @map("position_title") @db.VarChar(100)
  seats         Int     @default(1)
  description   String? @db.VarChar(500)

  election   Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidates ElectionCandidate[]
  votes      ElectionVote[]

  @@map("election_positions")
}

model ElectionCandidate {
  id              String    @id @default(uuid()) @db.Uuid
  positionId      String    @map("position_id") @db.Uuid
  personId        String    @map("person_id") @db.Uuid
  candidateName   String    @default("Candidate") @map("candidate_name") @db.VarChar(255)
  nominationType  String    @default("SELF") @map("nomination_type") @db.VarChar(20)
  status          String    @default("DRAFT") @map("status") @db.VarChar(30)
  manifesto       String?   @db.Text
  manifestoPdfUrl String?   @map("manifesto_pdf_url") @db.VarChar(500)
  photoUrl        String?   @map("photo_url") @db.VarChar(500)
  videoUrl        String?   @map("video_url") @db.VarChar(500)
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  submittedAt     DateTime? @map("submitted_at")
  approvedAt      DateTime? @map("approved_at")
  withdrawnAt     DateTime? @map("withdrawn_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  position ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@map("election_candidates")
}

model ElectionVote {
  id          String   @id @default(uuid()) @db.Uuid
  positionId  String   @map("position_id") @db.Uuid
  voterHash   String   @map("voter_hash") @db.VarChar(128)
  candidateId String   @map("candidate_id") @db.Uuid
  source      String   @default("APP") @db.VarChar(10)
  proxyId     String?  @map("proxy_id") @db.Uuid
  castAt      DateTime @default(now()) @map("cast_at")

  position ElectionPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, voterHash])
  @@map("election_votes")
}

model ElectionAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  electionId String   @map("election_id") @db.Uuid
  action     String   @db.VarChar(100)
  actorId    String   @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role") @db.VarChar(50)
  details    String?  @db.Text
  timestamp  DateTime @default(now())

  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@index([electionId, timestamp])
  @@map("election_audit_logs")
}

model Committee {
  id              String   @id @default(uuid()) @db.Uuid
  societyId       String   @map("society_id") @db.Uuid
  electionId      String?  @map("election_id") @db.Uuid
  name            String   @db.VarChar(255)
  tenureStartDate DateTime @map("tenure_start_date")
  tenureEndDate   DateTime @map("tenure_end_date")
  status          String   @default("ACTIVE") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at")

  society Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  members CommitteeMember[]

  @@index([societyId, status])
  @@map("committees")
}

model CommitteeMember {
  id          String   @id @default(uuid()) @db.Uuid
  committeeId String   @map("committee_id") @db.Uuid
  personId    String   @map("person_id") @db.Uuid
  memberName  String   @default("Member") @map("member_name") @db.VarChar(255)
  position    String   @db.VarChar(100)
  joinedAt    DateTime @default(now()) @map("joined_at")

  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@map("committee_members")
}
