  societyId     String  @map("society_id") @db.Uuid
  userId        String? @map("user_id") @db.Uuid
  staffTypeCode String  @map("staff_type_code") @db.VarChar(50)
  employeeCode  String  @map("employee_code") @db.VarChar(50)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("staff")
}

