// ======================================================
// 1. REUSABLE MASTER DATA TABLES
// ======================================================

model MasterCountry {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(10)
  name      String       @db.VarChar(100)
  phoneCode String       @map("phone_code") @db.VarChar(10)
  states    MasterState[]

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("master_countries")
}

model MasterState {
  id        String       @id @default(uuid()) @db.Uuid
  countryId String       @map("country_id") @db.Uuid
  code      String       @db.VarChar(10)
  name      String       @db.VarChar(100)
  country   MasterCountry @relation(fields: [countryId], references: [id])
  cities    MasterCity[]

  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([countryId, code])
  @@map("master_states")
}

model MasterCity {
  id        String      @id @default(uuid()) @db.Uuid
  stateId   String      @map("state_id") @db.Uuid
  name      String      @db.VarChar(100)
  state     MasterState @relation(fields: [stateId], references: [id])
  areas     MasterArea[]

  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("master_cities")
}

model MasterArea {
  id      String     @id @default(uuid()) @db.Uuid
  cityId  String     @map("city_id") @db.Uuid
  name    String     @db.VarChar(100)
  pincode String     @db.VarChar(20)
  city    MasterCity @relation(fields: [cityId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("master_areas")
}

model MasterCategory {
  id          String   @id @default(uuid()) @db.Uuid
  domain      String   @db.VarChar(50)
  code        String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([domain, code])
  @@map("master_categories")
}

// ======================================================
// 2. SAAS SUBSCRIPTION & FEATURE FLAG SYSTEM
// ======================================================

model SubscriptionPlan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  monthlyPrice Decimal  @default(0) @map("monthly_price") @db.Decimal(10, 2)
  annualPrice  Decimal  @default(0) @map("annual_price") @db.Decimal(10, 2)
  maxFlats    Int      @default(50) @map("max_flats")
  maxUsers    Int      @default(100) @map("max_users")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  features      PlanFeature[]
  subscriptions SocietySubscription[]

  @@map("subscription_plans")
}

model SubscriptionFeature {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(100)
  module      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  planFeatures PlanFeature[]

  @@map("subscription_features")
}

model PlanFeature {
  id        String @id @default(uuid()) @db.Uuid
  planId    String @map("plan_id") @db.Uuid
  featureId String @map("feature_id") @db.Uuid

  plan    SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature SubscriptionFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([planId, featureId])
  @@map("plan_features")
}

model SocietySubscription {
  id           String             @id @default(uuid()) @db.Uuid
  societyId    String             @map("society_id") @db.Uuid
  planId       String             @map("plan_id") @db.Uuid
  status       SubscriptionStatus @default(TRIAL)
  billingCycle BillingCycle       @default(MONTHLY) @map("billing_cycle")
  startDate    DateTime           @map("start_date")
  endDate      DateTime           @map("end_date")
  autoRenew    Boolean            @default(true) @map("auto_renew")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  society  Society          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  invoices InvoiceHistory[]

  @@index([societyId, status])
  @@map("society_subscriptions")
}

model InvoiceHistory {
  id             String        @id @default(uuid()) @db.Uuid
  subscriptionId String        @map("subscription_id") @db.Uuid
  societyId      String        @map("society_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(50)
  amount         Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(10, 2)
  dueDate        DateTime      @map("due_date")
  paidAt         DateTime?     @map("paid_at")
  status         InvoiceStatus @default(DRAFT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscription SocietySubscription @relation(fields: [subscriptionId], references: [id])
  society      Society             @relation(fields: [societyId], references: [id])
  payments     PaymentHistory[]

  @@map("invoice_history")
}

model PaymentHistory {
  id            String    @id @default(uuid()) @db.Uuid
  invoiceId     String    @map("invoice_id") @db.Uuid
  transactionId String    @unique @map("transaction_id") @db.VarChar(100)
  gateway       String    @db.VarChar(50)
  amount        Decimal   @db.Decimal(10, 2)
  paymentMethod String    @map("payment_method") @db.VarChar(50)
  status        String    @db.VarChar(50)
  paidAt        DateTime  @default(now()) @map("paid_at")

  invoice InvoiceHistory @relation(fields: [invoiceId], references: [id])

  @@map("payment_history")
}

// ======================================================
// 3. MULTI-TENANT CORE: SOCIETY & GENERIC PROPERTY HIERARCHY
// ======================================================

model Society {
  id              String        @id @default(uuid()) @db.Uuid
  code            String        @unique @db.VarChar(50)
  name            String        @db.VarChar(255)
  registrationNo  String?       @map("registration_no") @db.VarChar(100)
  societyTypeCode String        @map("society_type_code") @db.VarChar(50)
  addressLine1    String        @map("address_line_1") @db.VarChar(255)
  addressLine2    String?       @map("address_line_2") @db.VarChar(255)
  cityId          String?       @map("city_id") @db.Uuid
  pincode         String        @db.VarChar(20)
  contactEmail    String        @map("contact_email") @db.VarChar(255)
  contactPhone    String        @map("contact_phone") @db.VarChar(20)
  status          AccountStatus @default(PENDING)
  onboardingStep  Int           @default(1) @map("onboarding_step")
  isOnboarded     Boolean       @default(false) @map("is_onboarded")

  // Audit Fields
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  // Relations
  buildings        Building[]
  users            User[]
  residents        Resident[]
  tenants          Tenant[]
  staff            Staff[]
  vehicles         Vehicle[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  settings         Setting[]
  subscriptions    SocietySubscription[]
  invoices         InvoiceHistory[]
  files            MediaFile[]
  numberingConfigs NumberingConfig[]
  propertyConfig   PropertyConfig?
  people           Person[]
  gates            Gate[]
  accessLogs       AccessLog[]
  accessRules      AccessRule[]
  notificationTemplates NotificationTemplate[]
  notificationDispatches NotificationDispatch[]
  workflowTemplates WorkflowTemplate[]
  assetCategories  AssetCategory[]
  assets           Asset[]
  visitorPasses    VisitorPass[]
  documentFolders  DocumentFolder[]
  documents        Document[]
  financialAccounts FinancialAccount[]
  financialYears   FinancialYear[]
  journalEntries   JournalEntry[]
  financialTransactions FinancialTransaction[]
  wallets          MemberWallet[]
  reportConfigs    ReportConfig[]
  dashboardWidgets DashboardWidget[]
  complaints       Complaint[]
  workOrders       WorkOrder[]
  maintenanceBillConfig MaintenanceBillConfig?
  maintenanceBills MaintenanceBill[]
  amenities        Amenity[]
  amenityBookings  AmenityBooking[]
  parkingZones     ParkingZone[]
  parkingSlots     ParkingSlot[]
  parkingAllocations ParkingAllocation[]
  vendors          Vendor[]
  amcContracts     AmcContract[]
  serviceVisits    ServiceVisit[]
  meetings         Meeting[]
  meetingTemplates MeetingTemplate[]
  notices          Notice[]
  noticeTemplates  NoticeTemplate[]
  elections        Election[]
  committees       Committee[]

  @@index([isDeleted])
  @@map("societies")
}

model PropertyConfig {
  id                 String  @id @default(uuid()) @db.Uuid
  societyId          String  @unique @map("society_id") @db.Uuid
  blockLabel         String  @default("Tower") @map("block_label") @db.VarChar(50)
  hasWings           Boolean @default(true) @map("has_wings")
  hasFloors          Boolean @default(true) @map("has_floors")
  isSeparateParking  Boolean @default(true) @map("is_separate_parking")
  autoUnitNumbering  Boolean @default(true) @map("auto_unit_numbering")
  unitNumberPattern  String  @default("{block}-{wing}-{unit}") @map("unit_number_pattern") @db.VarChar(100)

  updatedAt DateTime @updatedAt @map("updated_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@map("property_configs")
}

model Building {
  id        String  @id @default(uuid()) @db.Uuid
  societyId String  @map("society_id") @db.Uuid
  code      String  @db.VarChar(50)
  name      String  @db.VarChar(100)
  typeCode  String? @map("type_code") @db.VarChar(50)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  wings   Wing[]
  flats   Flat[]
  assets  Asset[]

  @@index([societyId, isDeleted])
  @@map("buildings")
}

model Wing {
  id         String @id @default(uuid()) @db.Uuid
  buildingId String @map("building_id") @db.Uuid
  societyId  String @map("society_id") @db.Uuid
  code       String @db.VarChar(50)
  name       String @db.VarChar(50)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  floors   Floor[]
  flats    Flat[]
  assets   Asset[]

  @@index([buildingId, isDeleted])
  @@index([societyId])
  @@map("wings")
}

model Floor {
  id          String @id @default(uuid()) @db.Uuid
  wingId      String? @map("wing_id") @db.Uuid
  buildingId  String @map("building_id") @db.Uuid
  societyId   String @map("society_id") @db.Uuid
  code        String @db.VarChar(50)
  floorNumber Int    @map("floor_number")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  wing  Wing?  @relation(fields: [wingId], references: [id], onDelete: Cascade)
  flats Flat[]

  @@index([buildingId, isDeleted])
  @@index([societyId])
  @@map("floors")
}

model Flat {
  id             String   @id @default(uuid()) @db.Uuid
  floorId        String?  @map("floor_id") @db.Uuid
  wingId         String?  @map("wing_id") @db.Uuid
  buildingId     String   @map("building_id") @db.Uuid
  societyId      String   @map("society_id") @db.Uuid
  code           String   @db.VarChar(50)
  flatNumber     String   @map("flat_number") @db.VarChar(50)
  unitType       UnitType @default(APARTMENT) @map("unit_type")
  flatTypeCode   String?  @map("flat_type_code") @db.VarChar(50)
  sqFt           Float?   @map("sq_ft")
  status         String   @default("VACANT") @db.VarChar(50)
  intercomNumber String?  @map("intercom_number") @db.VarChar(20)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  building      Building       @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  wing          Wing?          @relation(fields: [wingId], references: [id], onDelete: Cascade)
  floor         Floor?         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  residents     Resident[]
  tenants       Tenant[]
  vehicles      Vehicle[]
  familyMembers FamilyMember[]
  personUnits   PersonUnit[]
  visitorPasses VisitorPass[]
  financialTransactions FinancialTransaction[]
  complaints    Complaint[]
  maintenanceBills MaintenanceBill[]
  parkingAllocations ParkingAllocation[]

  @@index([buildingId, isDeleted], map: "flats_building_id_is_deleted_idx")
  @@index([societyId, isDeleted], map: "flats_society_id_is_deleted_idx")
  @@map("flats")
}

// ======================================================
// 4. MASTER PERSON ENTITY
// ======================================================

model Person {
  id           String        @id @default(uuid()) @db.Uuid
  societyId    String        @map("society_id") @db.Uuid
  userId       String?       @unique @map("user_id") @db.Uuid
  digitalId    String        @unique @map("digital_id") @db.VarChar(50)
  firstName    String        @map("first_name") @db.VarChar(100)
  lastName     String        @map("last_name") @db.VarChar(100)
  email        String?       @db.VarChar(255)
  phone        String        @db.VarChar(20)
  gender       Gender        @default(MALE)
  avatarUrl    String?       @map("avatar_url") @db.VarChar(500)
  
  identityType   String?     @map("identity_type") @db.VarChar(50)
  identityNumber String?     @map("identity_number") @db.VarChar(100)
  kycStatus      KycStatus   @default(PENDING) @map("kyc_status")

  status AccountStatus @default(ACTIVE)

  emergencyContacts Json? @map("emergency_contacts")

  digitalIdQrToken       String? @map("digital_id_qr_token") @db.VarChar(255)
  isAttendanceReady      Boolean @default(true) @map("is_attendance_ready")
  isFaceRecognitionReady Boolean @default(false) @map("is_face_recognition_ready")
  isMobileAppReady       Boolean @default(false) @map("is_mobile_app_ready")
  isVisitorReady         Boolean @default(true) @map("is_visitor_ready")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  society     Society      @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  roles       PersonRole[]
  unitMappings PersonUnit[]
  vehicles    Vehicle[]
  accessLogs  AccessLog[]
  visitorPassesAsVisitor VisitorPass[] @relation("VisitorPerson")
  visitorPassesAsHost    VisitorPass[] @relation("HostPerson")
  financialTransactions FinancialTransaction[]
  wallet      MemberWallet?
  reportedComplaints Complaint[] @relation("ReportedByPerson")
  assignedComplaints StaffComplaintAssignment[]
  assignedWorkOrders WorkOrder[] @relation("AssignedWorkOrderStaff")
  maintenanceBills   MaintenanceBill[]
  amenityBookings    AmenityBooking[]
  parkingAllocations ParkingAllocation[]
  chairedMeetings    Meeting[] @relation("MeetingChairPerson")
  secretariedMeetings Meeting[] @relation("MeetingSecretaryPerson")
  meetingParticipants MeetingParticipant[]
  assignedMeetingTasks MeetingActionItem[] @relation("MeetingTaskOwner")
  createdNotices      Notice[]            @relation("NoticeCreatedBy")
  approvedNotices     Notice[]            @relation("NoticeApprovedBy")
  noticeRecipients    NoticeRecipient[]

  @@index([societyId, isDeleted])
  @@index([phone])
  @@index([digitalId])
  @@map("people")
}

model StaffComplaintAssignment {
  id          String @id @default(uuid()) @db.Uuid
  complaintId String @map("complaint_id") @db.Uuid
  staffId     String @map("staff_id") @db.Uuid

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  staff     Person    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([complaintId, staffId])
  @@map("staff_complaint_assignments")
}

model PersonRole {
  id         String             @id @default(uuid()) @db.Uuid
  personId   String             @map("person_id") @db.Uuid
  roleCode   PersonRoleCategory @map("role_code")
  assignedAt DateTime           @default(now()) @map("assigned_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, roleCode])
  @@map("person_roles")
}

model PersonUnit {
  id                 String    @id @default(uuid()) @db.Uuid
  personId           String    @map("person_id") @db.Uuid
  unitId             String    @map("unit_id") @db.Uuid
  isPrimaryOccupant  Boolean   @default(false) @map("is_primary_occupant")
  moveInDate         DateTime? @map("move_in_date")
  moveOutDate        DateTime? @map("move_out_date")
  occupancyStatus    String    @default("ACTIVE") @map("occupancy_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  unit   Flat   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([personId, unitId])
  @@map("person_units")
}

// ======================================================
// 5. REUSABLE ENTERPRISE ACCESS CONTROL ENGINE
// ======================================================

model Gate {
  id        String  @id @default(uuid()) @db.Uuid
  societyId String  @map("society_id") @db.Uuid
  code      String  @db.VarChar(50)
  name      String  @db.VarChar(100)
  gateType  String  @default("BI_DIRECTIONAL") @map("gate_type") @db.VarChar(50)
  status    String  @default("ACTIVE") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  society    Society     @relation(fields: [societyId], references: [id], onDelete: Cascade)
  accessLogs AccessLog[]

  @@unique([societyId, code])
  @@map("gates")
}

model AccessRule {
  id          String   @id @default(uuid()) @db.Uuid
  societyId   String   @map("society_id") @db.Uuid
  ruleType    RuleType @map("rule_type")
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityValue String   @map("entity_value") @db.VarChar(100)
  reason      String?  @db.VarChar(255)
  expiresAt   DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @db.Uuid @map("created_by")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([societyId, ruleType, entityType, entityValue])
  @@map("access_rules")
}

model AccessLog {
  id              String          @id @default(uuid()) @db.Uuid
  societyId       String          @map("society_id") @db.Uuid
  gateId          String          @map("gate_id") @db.Uuid
  personId        String?         @map("person_id") @db.Uuid
  vehicleId       String?         @map("vehicle_id") @db.Uuid
  accessType      AccessType      @map("access_type")
  entryMethod     EntryMethod     @map("entry_method")
  direction       AccessDirection @default(ENTRY)
  entryTime       DateTime        @default(now()) @map("entry_time")
  exitTime        DateTime?       @map("exit_time")
  durationMinutes Int?            @map("duration_minutes")
  isOverstay      Boolean         @default(false) @map("is_overstay")
  approvalSource  String          @default("SECURITY_GUARD") @map("approval_source") @db.VarChar(50)
  securityGuardId String?         @map("security_guard_id") @db.Uuid
  vehicleNumber   String?         @map("vehicle_number") @db.VarChar(50)
  photoUrl        String?         @map("photo_url") @db.VarChar(500)
  qrToken         String?         @map("qr_token") @db.VarChar(255)
  otpToken        String?         @map("otp_token") @db.VarChar(50)
  remarks         String?         @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  society Society  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  gate    Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  person  Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  visitorPasses VisitorPass[]

  @@index([societyId, direction, exitTime])
  @@index([societyId, isOverstay])
  @@index([vehicleNumber])
  @@map("access_logs")
}

// ======================================================
// 6. ENTERPRISE COMMUNICATION & NOTIFICATION ENGINE
// ======================================================

model NotificationTemplate {
  id            String               @id @default(uuid()) @db.Uuid
  societyId     String?              @map("society_id") @db.Uuid
  code          String               @unique @db.VarChar(100)
  name          String               @db.VarChar(150)
  category      NotificationCategory @default(INFORMATION)
  channel       NotificationChannel  @default(IN_APP)
  titleTemplate String               @map("title_template") @db.VarChar(255)
  bodyTemplate  String               @map("body_template") @db.Text
  variables     Json?
  isActive      Boolean              @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  society Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
  dispatches NotificationDispatch[]

  @@map("notification_templates")
}

model NotificationDispatch {
  id             String               @id @default(uuid()) @db.Uuid
  societyId      String               @map("society_id") @db.Uuid
  templateId     String?              @map("template_id") @db.Uuid
  channel        NotificationChannel  @default(IN_APP)
  category       NotificationCategory @default(INFORMATION)
  priority       NotificationPriority @default(MEDIUM)
  recipientType  String               @map("recipient_type") @db.VarChar(50)
  recipientId    String               @map("recipient_id") @db.VarChar(100)
  title          String               @db.VarChar(255)
  message        String               @db.Text
  metadata       Json?
  status         DispatchStatus       @default(QUEUED)
  scheduledAt    DateTime             @default(now()) @map("scheduled_at")
  sentAt         DateTime?            @map("sent_at")
  failureReason  String?              @map("failure_reason") @db.VarChar(255)
  retryCount     Int                  @default(0) @map("retry_count")

  createdAt DateTime @default(now()) @map("created_at")

  society  Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([societyId, status])
  @@map("notification_dispatches")
}

// ======================================================
// 7. GENERIC ENTERPRISE WORKFLOW & APPROVAL ENGINE
// ======================================================

model WorkflowTemplate {
  id                   String               @id @default(uuid()) @db.Uuid
  societyId            String?              @map("society_id") @db.Uuid
  code                 String               @unique @db.VarChar(100)
  name                 String               @db.VarChar(150)
  entityType           String               @map("entity_type") @db.VarChar(100)
  approvalType         WorkflowApprovalType @default(SEQUENTIAL) @map("approval_type")
  slaHours             Int                  @default(24) @map("sla_hours")
  autoApproveThreshold Float?               @map("auto_approve_threshold")
  isActive             Boolean              @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  society   Society?               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  steps     WorkflowTemplateStep[]
  instances WorkflowInstance[]

  @@map("workflow_templates")
}

model WorkflowTemplateStep {
  id                      String                 @id @default(uuid()) @db.Uuid
  templateId              String                 @map("template_id") @db.Uuid
  stepNumber              Int                    @map("step_number")
  stepName                String                 @map("step_name") @db.VarChar(100)
  assignmentType          WorkflowAssignmentType @default(ROLE) @map("assignment_type")
  assigneeRole            RoleType?              @map("assignee_role")
  assigneeUserId          String?                @map("assignee_user_id") @db.Uuid
  requireDigitalSignature Boolean                @default(false) @map("require_digital_signature")

  template WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, stepNumber])
  @@map("workflow_template_steps")
}

model WorkflowInstance {
  id                String         @id @default(uuid()) @db.Uuid
  societyId         String         @map("society_id") @db.Uuid
  templateId        String?        @map("template_id") @db.Uuid
  entityType        String         @map("entity_type") @db.VarChar(100)
  entityId          String         @map("entity_id") @db.Uuid
  title             String         @db.VarChar(255)
  notes             String?
  status            ApprovalStatus @default(PENDING)
  currentStepNumber Int            @default(1) @map("current_step_number")
  slaDueDate        DateTime?      @map("sla_due_date")
  isEscalated       Boolean        @default(false) @map("is_escalated")
  signatureHash     String?        @map("signature_hash") @db.VarChar(255)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")

  template WorkflowTemplate?     @relation(fields: [templateId], references: [id], onDelete: SetNull)
  steps    WorkflowStepInstance[]
  comments WorkflowComment[]
  visitorPasses VisitorPass[]
  documents Document[]
  complaints Complaint[]

  @@index([societyId, entityType, entityId])
  @@index([societyId, status])
  @@map("workflow_instances")
}

model WorkflowStepInstance {
  id                      String         @id @default(uuid()) @db.Uuid
  instanceId              String         @map("instance_id") @db.Uuid
  stepNumber              Int            @map("step_number")
  stepName                String         @map("step_name") @db.VarChar(100)
  roleCode                RoleType       @map("role_code")
  approverId              String?        @map("approver_id") @db.Uuid
  status                  ApprovalStatus @default(PENDING)
  comments                String?
  signatureHash           String?        @map("signature_hash") @db.VarChar(255)
  actionAt                DateTime?      @map("action_at")

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("workflow_step_instances")
}

model WorkflowComment {
  id            String   @id @default(uuid()) @db.Uuid
  instanceId    String   @map("instance_id") @db.Uuid
  actorId       String   @map("actor_id") @db.Uuid
  comment       String   @db.Text
  attachmentUrl String?  @map("attachment_url") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("workflow_comments")
}

model ApprovalWorkflow {
  id         String         @id @default(uuid()) @db.Uuid
  societyId  String         @map("society_id") @db.Uuid
  entityType String         @map("entity_type") @db.VarChar(100)
  entityId   String         @map("entity_id") @db.Uuid
  status     ApprovalStatus @default(PENDING)
  title      String         @db.VarChar(255)
  notes      String?

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")

  steps ApprovalStep[]

  @@index([societyId, entityType, entityId])
  @@map("approval_workflows")
}

model ApprovalStep {
  id         String         @id @default(uuid()) @db.Uuid
  workflowId String         @map("workflow_id") @db.Uuid
  stepNumber Int            @map("step_number")
  roleCode   RoleType       @map("role_code")
  approverId String?        @map("approver_id") @db.Uuid
  status     ApprovalStatus @default(PENDING)
  comments   String?
  actionAt   DateTime?      @map("action_at")

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("approval_steps")
}

// ======================================================
// 8. ENTERPRISE ASSET & RESOURCE MANAGEMENT ENGINE
// ======================================================

model AssetCategory {
  id          String   @id @default(uuid()) @db.Uuid
  societyId   String?  @map("society_id") @db.Uuid
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  society Society? @relation(fields: [societyId], references: [id], onDelete: Cascade)
  assets  Asset[]

  @@map("asset_categories")
}

model Asset {
  id                      String      @id @default(uuid()) @db.Uuid
  societyId               String      @map("society_id") @db.Uuid
  categoryId              String      @map("category_id") @db.Uuid
  assetCode               String      @unique @map("asset_code") @db.VarChar(50)
  name                    String      @db.VarChar(200)
  brand                   String?     @db.VarChar(100)
  modelNumber             String?     @map("model_number") @db.VarChar(100)
  serialNumber            String?     @map("serial_number") @db.VarChar(100)
  
  qrToken                 String?     @map("qr_token") @db.VarChar(255)
  barcode                 String?     @db.VarChar(100)
  rfidTag                 String?     @map("rfid_tag") @db.VarChar(100)
  
  buildingId              String?     @map("building_id") @db.Uuid
  wingId                  String?     @map("wing_id") @db.Uuid
  locationDetails         String?     @map("location_details") @db.VarChar(255)

  purchaseDate            DateTime?   @map("purchase_date")
  installationDate        DateTime?   @map("installation_date")
  warrantyExpiry          DateTime?   @map("warranty_expiry")
  amcExpiry               DateTime?   @map("amc_expiry")
  vendorName              String?     @map("vendor_name") @db.VarChar(150)
  vendorPhone             String?     @map("vendor_phone") @db.VarChar(20)

  purchaseCost            Decimal     @default(0) @map("purchase_cost") @db.Decimal(12, 2)
  currentValue            Decimal     @default(0) @map("current_value") @db.Decimal(12, 2)
  depreciationRate        Float       @default(0) @map("depreciation_rate")

  maintenanceIntervalDays Int         @default(30) @map("maintenance_interval_days")
  lastServiceDate         DateTime?   @map("last_service_date")
  nextServiceDate         DateTime?   @map("next_service_date")
  personResponsibleId     String?     @map("person_responsible_id") @db.Uuid

  status                  AssetStatus @default(OPERATIONAL)

  photos                  Json?
  documents               Json?
  spareParts              Json?

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  society   Society       @relation(fields: [societyId], references: [id], onDelete: Cascade)
  category  AssetCategory @relation(fields: [categoryId], references: [id])
  building  Building?     @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  wing      Wing?         @relation(fields: [wingId], references: [id], onDelete: SetNull)
  logs      AssetLog[]
  complaints Complaint[]
  workOrders WorkOrder[]
  amcAssets  AmcAssetLink[]

  @@index([societyId, isDeleted])
  @@index([status])
  @@map("assets")
}

model AssetLog {
  id          String       @id @default(uuid()) @db.Uuid
  assetId     String       @map("asset_id") @db.Uuid
  logType     AssetLogType @map("log_type")
  title       String       @db.VarChar(255)
  description String?      @db.Text
  cost        Decimal      @default(0) @db.Decimal(10, 2)
  performedBy String?      @map("performed_by") @db.VarChar(100)
  logDate     DateTime     @default(now()) @map("log_date")

  createdAt DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_logs")
}

// ======================================================
// 9. ENTERPRISE VISITOR MANAGEMENT MODULE
// ======================================================

model VisitorPass {
  id                 String              @id @default(uuid()) @db.Uuid
  societyId          String              @map("society_id") @db.Uuid
  passNumber         String              @unique @map("pass_number") @db.VarChar(50)
  passType           String              @default("INSTANT") @map("pass_type") @db.VarChar(50)
  visitorType        VisitorTypeCategory @map("visitor_type")
  visitorName        String              @map("visitor_name") @db.VarChar(150)
  visitorPhone       String              @map("visitor_phone") @db.VarChar(20)
  visitorEmail       String?             @map("visitor_email") @db.VarChar(255)

  personId           String?             @map("person_id") @db.Uuid
  hostPersonId       String?             @map("host_person_id") @db.Uuid
  hostUnitId         String?             @map("host_unit_id") @db.Uuid
  workflowInstanceId String?             @map("workflow_instance_id") @db.Uuid
  accessLogId        String?             @map("access_log_id") @db.Uuid

  purpose            String?             @db.VarChar(255)
  vehicleNumber      String?             @map("vehicle_number") @db.VarChar(50)

  expectedArrival    DateTime?           @map("expected_arrival")
  expectedExit       DateTime?           @map("expected_exit")
  actualArrival      DateTime?           @map("actual_arrival")
  actualExit         DateTime?           @map("actual_exit")

  qrToken            String?             @map("qr_token") @db.VarChar(255)
  otpCode            String?             @map("otp_code") @db.VarChar(10)
  photoUrl           String?             @map("photo_url") @db.VarChar(500)
  idProofUrl         String?             @map("id_proof_url") @db.VarChar(500)

  status             VisitorPassStatus   @default(CHECKED_IN)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  society          Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  visitorPerson    Person?           @relation("VisitorPerson", fields: [personId], references: [id], onDelete: SetNull)
  hostPerson       Person?           @relation("HostPerson", fields: [hostPersonId], references: [id], onDelete: SetNull)
  hostUnit         Flat?             @relation(fields: [hostUnitId], references: [id], onDelete: SetNull)
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  accessLog        AccessLog?        @relation(fields: [accessLogId], references: [id], onDelete: SetNull)

  @@index([societyId, status])
  @@index([visitorPhone])
  @@index([passNumber])
  @@map("visitor_passes")
}

// ======================================================
// 10. ENTERPRISE DOCUMENT & FILE MANAGEMENT ENGINE
// ======================================================

model DocumentFolder {
  id        String  @id @default(uuid()) @db.Uuid
  societyId String  @map("society_id") @db.Uuid
  parentId  String? @map("parent_id") @db.Uuid
  name      String  @db.VarChar(100)
  path      String  @default("/") @db.VarChar(255)
  isSystem  Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  society   Society          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  parent    DocumentFolder?  @relation("SubFolders", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("SubFolders")
  documents Document[]

  @@unique([societyId, parentId, name])
  @@map("document_folders")
}

model Document {
  id                  String          @id @default(uuid()) @db.Uuid
  societyId           String          @map("society_id") @db.Uuid
  folderId            String?         @map("folder_id") @db.Uuid
  documentCode        String          @unique @map("document_code") @db.VarChar(50)
  title               String          @db.VarChar(200)
  description         String?         @db.Text
  category            String          @default("GENERAL") @db.VarChar(50)
  
  entityType          String?         @map("entity_type") @db.VarChar(50)
  entityId            String?         @map("entity_id") @db.Uuid

  mimeType            String          @map("mime_type") @db.VarChar(100)
  extension           String          @db.VarChar(20)
  sizeBytes           BigInt          @map("size_bytes")
  storageProvider     StorageProvider @default(LOCAL) @map("storage_provider")
  storageKey          String          @map("storage_key") @db.VarChar(500)
  fileUrl             String          @map("file_url") @db.VarChar(1000)
  thumbnailUrl        String?         @map("thumbnail_url") @db.VarChar(1000)

  version             Int             @default(1)
  fileHash            String?         @map("file_hash") @db.VarChar(128)

  isPrivate           Boolean         @default(false) @map("is_private")
  accessRoles         Json?           @map("access_roles")
  tags                Json?

  expiryDate          DateTime?       @map("expiry_date")
  renewalReminderDate DateTime?       @map("renewal_reminder_date")

  workflowInstanceId  String?         @map("workflow_instance_id") @db.Uuid

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  society          Society           @relation(fields: [societyId], references: [id], onDelete: Cascade)
  folder           DocumentFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  workflowInstance WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]

  @@index([societyId, isDeleted])
  @@index([entityType, entityId])
  @@index([fileHash])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  version     Int
  fileUrl     String   @map("file_url") @db.VarChar(1000)
  storageKey  String   @map("storage_key") @db.VarChar(500)
  sizeBytes   BigInt   @map("size_bytes")
  fileHash    String?  @map("file_hash") @db.VarChar(128)
  changeNotes String?  @map("change_notes") @db.VarChar(255)
  createdBy   String?  @db.Uuid @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_versions")
}

// ======================================================
// 11. ENTERPRISE FINANCIAL & ACCOUNTING ENGINE
// ======================================================

model FinancialAccount {
  id          String               @id @default(uuid()) @db.Uuid
  societyId   String               @map("society_id") @db.Uuid
  accountCode String               @map("account_code") @db.VarChar(50)
  accountName String               @map("account_name") @db.VarChar(100)
  type        FinancialAccountType
  balance     Decimal              @default(0) @db.Decimal(14, 2)
  isSystem    Boolean              @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  society      Society              @relation(fields: [societyId], references: [id], onDelete: Cascade)
  journalItems JournalEntryItem[]

  @@unique([societyId, accountCode])
  @@map("financial_accounts")
}

model FinancialYear {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @map("society_id") @db.Uuid
  yearCode  String   @map("year_code") @db.VarChar(20)
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isClosed  Boolean  @default(false) @map("is_closed")

  createdAt DateTime @default(now()) @map("created_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([societyId, yearCode])
  @@map("financial_years")
}

model JournalEntry {
  id              String   @id @default(uuid()) @db.Uuid
  societyId       String   @map("society_id") @db.Uuid
  entryNumber     String   @unique @map("entry_number") @db.VarChar(50)
  entryDate       DateTime @default(now()) @map("entry_date")
  narration       String   @db.VarChar(255)
  referenceNumber String?  @map("reference_number") @db.VarChar(100)
  totalAmount     Decimal  @db.Decimal(14, 2)
  isPosted        Boolean  @default(true) @map("is_posted")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @db.Uuid @map("created_by")

  society Society            @relation(fields: [societyId], references: [id], onDelete: Cascade)
  items   JournalEntryItem[]

  @@index([societyId, entryDate])
  @@map("journal_entries")
}

model JournalEntryItem {
  id             String  @id @default(uuid()) @db.Uuid
  journalEntryId String  @map("journal_entry_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  debitAmount    Decimal @default(0) @map("debit_amount") @db.Decimal(14, 2)
  creditAmount   Decimal @default(0) @map("credit_amount") @db.Decimal(14, 2)
  notes          String? @db.VarChar(255)

  entry   JournalEntry     @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("journal_entry_items")
}

model FinancialTransaction {
  id                String          @id @default(uuid()) @db.Uuid
  societyId         String          @map("society_id") @db.Uuid
  txnNumber         String          @unique @map("txn_number") @db.VarChar(50)
  txnType           TransactionType @map("txn_type")
  txnDate           DateTime        @default(now()) @map("txn_date")
  dueDate           DateTime?       @map("due_date")
  
  personId          String?         @map("person_id") @db.Uuid
  unitId            String?         @map("unit_id") @db.Uuid

  subtotal          Decimal         @default(0) @db.Decimal(14, 2)
  taxAmount         Decimal         @default(0) @map("tax_amount") @db.Decimal(14, 2)
  penaltyAmount     Decimal         @default(0) @map("penalty_amount") @db.Decimal(14, 2)
  discountAmount    Decimal         @default(0) @map("discount_amount") @db.Decimal(14, 2)
  totalAmount       Decimal         @default(0) @map("total_amount") @db.Decimal(14, 2)
  paidAmount        Decimal         @default(0) @map("paid_amount") @db.Decimal(14, 2)
  outstandingAmount Decimal         @default(0) @map("outstanding_amount") @db.Decimal(14, 2)

  paymentMethod     PaymentMethod   @default(RAZORPAY) @map("payment_method")
  gatewayRef        String?         @map("gateway_ref") @db.VarChar(100)
  status            String          @default("UNPAID") @db.VarChar(50)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @db.Uuid @map("created_by")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  person  Person? @relation(fields: [personId], references: [id], onDelete: SetNull)
  unit    Flat?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  maintenanceBill MaintenanceBill?

  @@index([societyId, txnType, status])
  @@index([societyId, dueDate])
  @@map("financial_transactions")
}

model MemberWallet {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @map("society_id") @db.Uuid
  personId  String   @unique @map("person_id") @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  updatedAt DateTime @updatedAt @map("updated_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("member_wallets")
}

// ======================================================
// 12. ENTERPRISE ANALYTICS & REPORTING ENGINE
// ======================================================

model ReportConfig {
  id           String   @id @default(uuid()) @db.Uuid
  societyId    String   @map("society_id") @db.Uuid
  reportCode   String   @unique @map("report_code") @db.VarChar(50)
  title        String   @db.VarChar(150)
  description  String?  @db.Text
  domain       String   @db.VarChar(50)
  chartType    String   @default("BAR") @map("chart_type") @db.VarChar(50)
  queryConfig  Json?    @map("query_config")
  isScheduled  Boolean  @default(false) @map("is_scheduled")
  cronSchedule String?  @map("cron_schedule") @db.VarChar(50)
  recipients   Json?
  isFavorite   Boolean  @default(false) @map("is_favorite")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @db.Uuid @map("created_by")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@map("report_configs")
}

model DashboardWidget {
  id         String   @id @default(uuid()) @db.Uuid
  societyId  String   @map("society_id") @db.Uuid
  title      String   @db.VarChar(100)
  widgetType String   @map("widget_type") @db.VarChar(50)
  domain     String   @db.VarChar(50)
  gridPos    Json?    @map("grid_pos")
  queryConfig Json?   @map("query_config")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@map("dashboard_widgets")
}

// ======================================================
// 13. ENTERPRISE COMPLAINT & HELPDESK ENGINE
// ======================================================

model Complaint {
  id                 String            @id @default(uuid()) @db.Uuid
  societyId          String            @map("society_id") @db.Uuid
  ticketNumber       String            @unique @map("ticket_number") @db.VarChar(50)
  category           ComplaintCategory
  priority           ComplaintPriority @default(MEDIUM)
  status             ComplaintStatus   @default(OPEN)

  subject            String            @db.VarChar(255)
  description        String            @db.Text

  reportedById       String            @map("reported_by_id") @db.Uuid
  unitId             String?           @map("unit_id") @db.Uuid
  assetId            String?           @map("asset_id") @db.Uuid

  assignedVendorName String?           @map("assigned_vendor_name") @db.VarChar(150)
  workflowInstanceId String?           @map("workflow_instance_id") @db.Uuid

  slaHours           Int               @default(24) @map("sla_hours")
  slaDueDate         DateTime?         @map("sla_due_date")
  isEscalated        Boolean           @default(false) @map("is_escalated")

  resolutionNotes    String?           @map("resolution_notes") @db.Text
  rootCause          String?           @map("root_cause") @db.Text
  correctiveAction   String?           @map("corrective_action") @db.Text
  preventiveAction   String?           @map("preventive_action") @db.Text

  materialUsed       Json?             @map("material_used")
  cost               Decimal           @default(0) @db.Decimal(10, 2)

  starRating         Int?              @map("star_rating")
  residentFeedback   String?           @map("resident_feedback") @db.Text

  resolvedAt         DateTime?         @map("resolved_at")
  closedAt           DateTime?         @map("closed_at")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  society          Society                  @relation(fields: [societyId], references: [id], onDelete: Cascade)
  reportedBy       Person                   @relation("ReportedByPerson", fields: [reportedById], references: [id], onDelete: Cascade)
  unit             Flat?                    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  asset            Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  workflowInstance WorkflowInstance?        @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  assignedStaff    StaffComplaintAssignment[]
  workOrders       WorkOrder[]

  @@index([societyId, status])
  @@index([societyId, priority])
  @@index([ticketNumber])
  @@map("complaints")
}

// ======================================================
// 14. ENTERPRISE PREVENTIVE & CORRECTIVE MAINTENANCE ENGINE
// ======================================================

model WorkOrder {
  id                 String            @id @default(uuid()) @db.Uuid
  societyId          String            @map("society_id") @db.Uuid
  workOrderNumber    String            @unique @map("work_order_number") @db.VarChar(50)
  type               WorkOrderType     @default(PREVENTIVE)
  priority           WorkOrderPriority @default(MEDIUM)
  status             WorkOrderStatus   @default(PLANNED)

  title              String            @db.VarChar(255)
  description        String            @db.Text

  assetId            String            @map("asset_id") @db.Uuid
  complaintId        String?           @map("complaint_id") @db.Uuid
  assignedStaffId    String?           @map("assigned_staff_id") @db.Uuid
  assignedVendorName String?           @map("assigned_vendor_name") @db.VarChar(150)

  scheduledDate      DateTime          @map("scheduled_date")
  completedAt        DateTime?         @map("completed_at")

  downtimeHours      Float             @default(0) @map("downtime_hours")
  labourCost         Decimal           @default(0) @map("labour_cost") @db.Decimal(10, 2)
  materialCost       Decimal           @default(0) @map("material_cost") @db.Decimal(10, 2)
  totalCost          Decimal           @default(0) @map("total_cost") @db.Decimal(10, 2)

  spareParts         Json?             @map("spare_parts")
  serviceChecklist   Json?             @map("service_checklist")

  rootCause          String?           @map("root_cause") @db.Text
  correctiveAction   String?           @map("corrective_action") @db.Text
  preventiveAction   String?           @map("preventive_action") @db.Text
  signatureHash      String?           @map("signature_hash") @db.VarChar(255)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  society       Society    @relation(fields: [societyId], references: [id], onDelete: Cascade)
  asset         Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  complaint     Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  assignedStaff Person?    @relation("AssignedWorkOrderStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([societyId, status])
  @@index([societyId, type])
  @@index([workOrderNumber])
  @@map("work_orders")
}

// ======================================================
// 15. ENTERPRISE MAINTENANCE BILLING ENGINE
// ======================================================

model MaintenanceBillConfig {
  id                    String       @id @default(uuid()) @db.Uuid
  societyId             String       @unique @map("society_id") @db.Uuid
  billingCycle          BillingCycle @default(MONTHLY) @map("billing_cycle")
  baseSqFtRate          Decimal      @default(2.5) @map("base_sqft_rate") @db.Decimal(8, 2)
  flatRatePerUnit       Decimal      @default(1500) @map("flat_rate_per_unit") @db.Decimal(10, 2)
  sinkingFundAmount     Decimal      @default(300) @map("sinking_fund_amount") @db.Decimal(10, 2)
  corpusFundAmount      Decimal      @default(200) @map("corpus_fund_amount") @db.Decimal(10, 2)
  parkingCharge2Wheeler Decimal      @default(100) @map("parking_charge_2wheeler") @db.Decimal(10, 2)
  parkingCharge4Wheeler Decimal      @default(500) @map("parking_charge_4wheeler") @db.Decimal(10, 2)
  waterCharge           Decimal      @default(150) @map("water_charge") @db.Decimal(10, 2)
  electricityCharge     Decimal      @default(200) @map("electricity_charge") @db.Decimal(10, 2)
  lateFeePercentage     Float        @default(5.0) @map("late_fee_percentage")
  dueDateDays           Int          @default(15) @map("due_date_days")
  gstPercentage         Float        @default(18.0) @map("gst_percentage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@map("maintenance_bill_configs")
}

model MaintenanceBill {
  id                     String   @id @default(uuid()) @db.Uuid
  societyId              String   @map("society_id") @db.Uuid
  billNumber             String   @unique @map("bill_number") @db.VarChar(50) // E.g. MB-2026-00001
  financialTransactionId String?  @unique @map("financial_transaction_id") @db.Uuid
  unitId                 String   @map("unit_id") @db.Uuid
  personId               String?  @map("person_id") @db.Uuid

  billingMonth           String   @map("billing_month") @db.VarChar(20) // E.g. 2026-07
  maintenanceAmount      Decimal  @default(0) @map("maintenance_amount") @db.Decimal(12, 2)
  sinkingFund            Decimal  @default(0) @map("sinking_fund") @db.Decimal(12, 2)
  corpusFund             Decimal  @default(0) @map("corpus_fund") @db.Decimal(12, 2)
  utilityCharges         Decimal  @default(0) @map("utility_charges") @db.Decimal(12, 2)
  parkingCharges         Decimal  @default(0) @map("parking_charges") @db.Decimal(12, 2)

  subtotal               Decimal  @default(0) @db.Decimal(12, 2)
  gstAmount              Decimal  @default(0) @map("gst_amount") @db.Decimal(12, 2)
  lateFee                Decimal  @default(0) @map("late_fee") @db.Decimal(12, 2)
  discount               Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount             Decimal  @default(0) @map("paid_amount") @db.Decimal(12, 2)
  outstandingAmount      Decimal  @default(0) @map("outstanding_amount") @db.Decimal(12, 2)

  dueDate                DateTime @map("due_date")
  status                 String   @default("UNPAID") @db.VarChar(50)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")

  society              Society               @relation(fields: [societyId], references: [id], onDelete: Cascade)
  financialTransaction FinancialTransaction? @relation(fields: [financialTransactionId], references: [id], onDelete: SetNull)
  unit                 Flat                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  person               Person?               @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([societyId, billingMonth, status])
  @@index([unitId, billingMonth])
  @@map("maintenance_bills")
}

// ======================================================
// 16. NUMBERING ENGINE CONFIGURATION
// ======================================================

model NumberingConfig {
  id         String @id @default(uuid()) @db.Uuid
  societyId  String @map("society_id") @db.Uuid
  entityType String @map("entity_type") @db.VarChar(50)
  prefix     String @db.VarChar(20)
  nextNumber Int    @default(1) @map("next_number")
  padding    Int    @default(5)

  updatedAt DateTime @updatedAt @map("updated_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([societyId, entityType])
  @@map("numbering_configs")
}

// ======================================================
// 17. UNIVERSAL ACTIVITY TIMELINE SYSTEM
// ======================================================

model ActivityTimeline {
