// ======================================================
// 18. CENTRALIZED 10-DOMAIN SETTINGS
// ======================================================

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  societyId String   @map("society_id") @db.Uuid
  domain    String   @db.VarChar(50)
  key       String   @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@unique([societyId, domain, key])
  @@map("settings")
}

// ======================================================
// 19. USERS, ROLES, OCCUPANTS & STAFF
// ======================================================

model User {
  id           String        @id @default(uuid()) @db.Uuid
  societyId    String?       @map("society_id") @db.Uuid
  email        String        @unique @db.VarChar(255)
  phone        String        @unique @db.VarChar(20)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  firstName    String        @map("first_name") @db.VarChar(100)
  lastName     String        @map("last_name") @db.VarChar(100)
  avatarUrl    String?       @map("avatar_url") @db.VarChar(500)
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?     @map("last_login_at")
  
  refreshTokenHash String?  @map("refresh_token_hash") @db.VarChar(255)
  preferredLang    String   @default("en") @map("preferred_lang") @db.VarChar(10)

  // Audit Fields
  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")
  updatedBy String?   @db.Uuid @map("updated_by")
  deletedBy String?   @db.Uuid @map("deleted_by")

  society         Society?          @relation(fields: [societyId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  residents       Resident[]
  tenants         Tenant[]
  staff           Staff[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  dashboardConfig DashboardConfig?
  personProfile   Person?

  @@index([societyId, isDeleted])
  @@index([email])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleType @unique
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(100)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Resident {
  id         String  @id @default(uuid()) @db.Uuid
  societyId  String  @map("society_id") @db.Uuid
  buildingId String  @map("building_id") @db.Uuid
  wingId     String? @map("wing_id") @db.Uuid
  floorId    String? @map("floor_id") @db.Uuid
  flatId     String  @map("flat_id") @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  isPrimary  Boolean @default(true) @map("is_primary")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  flat    Flat    @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([societyId, isDeleted])
  @@map("residents")
}

model Tenant {
  id         String   @id @default(uuid()) @db.Uuid
  societyId  String   @map("society_id") @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  wingId     String?  @map("wing_id") @db.Uuid
  floorId    String?  @map("floor_id") @db.Uuid
  flatId     String   @map("flat_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  leaseStart DateTime @map("lease_start")
  leaseEnd   DateTime @map("lease_end")
  isVerified Boolean  @default(false) @map("is_verified")

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  flat    Flat    @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@index([societyId, isDeleted])
  @@map("tenants")
}

model FamilyMember {
  id       String  @id @default(uuid()) @db.Uuid
  flatId   String  @map("flat_id") @db.Uuid
  fullName String  @map("full_name") @db.VarChar(200)
  relation String  @db.VarChar(50)
  gender   Gender
  phone    String? @db.VarChar(20)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  flat Flat @relation(fields: [flatId], references: [id], onDelete: Cascade)

  @@map("family_members")
}

model Vehicle {
  id            String  @id @default(uuid()) @db.Uuid
  societyId     String  @map("society_id") @db.Uuid
  flatId        String  @map("flat_id") @db.Uuid
  personId      String? @map("person_id") @db.Uuid
  vehicleNumber String  @map("vehicle_number") @db.VarChar(50)
  typeCode      String  @map("type_code") @db.VarChar(50)  // CAR, BIKE, EV_CAR, TRUCK, etc.
  parkingSlot   String? @map("parking_slot") @db.VarChar(50)

  // Enhanced vehicle details
  brand         String? @db.VarChar(100)
  modelName     String? @map("model_name") @db.VarChar(100)
  color         String? @db.VarChar(50)
  stickerNumber String? @map("sticker_number") @db.VarChar(50)

  // RFID / FASTag / QR
  rfidTag   String? @unique @map("rfid_tag") @db.VarChar(100)
  fasTag    String? @map("fas_tag") @db.VarChar(100)
  qrToken   String? @map("qr_token") @db.VarChar(255)

  // Compliance expiry dates
  registrationDate DateTime? @map("registration_date")
  insuranceExpiry  DateTime? @map("insurance_expiry")
  pucExpiry        DateTime? @map("puc_expiry")
  fitnessExpiry    DateTime? @map("fitness_expiry")

  // Document URLs
  rcDocUrl        String? @map("rc_doc_url") @db.VarChar(500)
  insuranceDocUrl String? @map("insurance_doc_url") @db.VarChar(500)
  photoUrl        String? @map("photo_url") @db.VarChar(500)

  isDeleted Boolean   @default(false) @map("is_deleted")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @db.Uuid @map("created_by")

  society     Society             @relation(fields: [societyId], references: [id], onDelete: Cascade)
  flat        Flat                @relation(fields: [flatId], references: [id], onDelete: Cascade)
  person      Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  accessLogs  AccessLog[]
  allocations ParkingAllocation[]

  @@index([societyId, isDeleted])
  @@index([vehicleNumber])
  @@index([rfidTag])
  @@map("vehicles")
}

model Staff {
